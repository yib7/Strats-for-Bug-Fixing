# Environment variables read by `pop`. Copy to `.env` and fill in as needed:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit real values. Nothing here is required: every
# variable below is optional, and the CPU reproduction path (`pop smoke`,
# `scripts/figures/make_all.py`, `mkdocs build`) needs none of them.
#
# NOTE: `pop` does not auto-load `.env` (there is no python-dotenv dependency).
# Export these in your shell, or use your runner's env-file support, e.g.:
#
#     set -a; . ./.env; set +a


# --- Experiment tracking (optional) ------------------------------------------
# Weights & Biases API key. When set, `pop pretrain` / `pop finetune` / `pop lora`
# add "wandb" to the HF Trainer's report_to list; when unset (the default) training
# runs local-only with no network calls and no account needed.
# Read by: src/pop/train/{pretrain,finetune,lora}.py
# Get one at https://wandb.ai/authorize
WANDB_API_KEY=


# --- Hugging Face Hub (optional; read by the libraries, not by `pop`) --------
# The network-using commands (`pop tokenizer`, `generate`, `rag`, `lora`,
# `lora-generate`) download datasets/models from the Hub. `huggingface_hub` attaches a
# User-Agent carrying its own, Python and torch versions to those requests; `pop` sends
# no telemetry of its own and never calls `send_telemetry`. Set to "1" to trim the
# User-Agent to the minimum.
HF_HUB_DISABLE_TELEMETRY=

# Set to "1" to block Hub access entirely (cache-only). The CPU reproduction path does
# not need the Hub at all and makes no network connections either way.
HF_HUB_OFFLINE=


# --- Training precision / memory knobs (optional) ----------------------------
# Force full fp32 training, disabling the bf16/fp16 autodetect. Set to exactly "1"
# to enable. Slower but numerically exact — the documented workaround for NaN or
# non-decreasing loss on fp16-only GPUs (e.g. a Colab T4).
# Read by: src/pop/train/precision.py
POP_FORCE_FP32=

# Fraction of total VRAM the trainers are allowed to reserve (float, default 0.85).
# Caps GPU memory so the one-time batch-size probes cannot spill into system RAM.
# Read by: src/pop/train/precision.py
POP_GPU_MEM_FRACTION=

# Override the auto-scaled per-device micro-batch size (int). The trainers normally
# pick this from the detected VRAM while holding the effective batch size at 64;
# set this only to pin it manually.
# Read by: src/pop/train/precision.py
POP_MICRO_BATCH=
