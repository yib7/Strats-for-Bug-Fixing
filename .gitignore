# venvs / package management
.venv/
.venv-rocm/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# uv
uv.lock.bak

# mkdocs build output
site/

# caches / test + coverage artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/
*.log

# results / artifacts (raw run outputs; keep summaries out of git)
results/raw/
# NOTE: results/scaling_data.csv and results/execbench_agreement.csv are the derived analysis CSVs.
# They are now COMMITTED (not ignored): scripts/figures/make_all.py rebuilds them from the committed
# results/*.json before rendering, so the figures reproduce from a clean checkout without any
# fixture fallback.
wandb/
outputs/
checkpoints/
logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# node (only if a docs/tooling dep ever pulls it in)
node_modules/

# model weights & archives - never belong in git (see docs/gpu-reproduction.md for where
# checkpoints live instead)
*.ckpt
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
# ...but the vendored JUnit/Hamcrest jars are part of the execution harness and ARE tracked
!benchmarks/lib/*.jar

# secrets - real values stay local; .env.example is the committed template
.env
.env.*
!.env.example
*.env
secrets.*
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc
.pypirc

# local tool state - development-only, never part of the shipped project
.superpowers/
.autopilot/
.claude/
